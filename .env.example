NODE_ENV=development
TZ=Europe/Lisbon
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info
DATABASE_URL=postgresql://sinapse_dev:CHANGE_ME@127.0.0.1:5432/sinapse_dev
TEST_DATABASE_URL=postgresql://sinapse_test:CHANGE_ME@127.0.0.1:5432/sinapse_test
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12
# false só em testes locais sem HTTPS
COOKIE_SECURE=true
# Origens autorizadas a fazer pedidos que alteram dados (separadas por vírgulas)
ALLOWED_ORIGINS=http://localhost:5173,https://abpt-dev.duckdns.org
LOGIN_RATE_LIMIT_PER_MINUTE=10
